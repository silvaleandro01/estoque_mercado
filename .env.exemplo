DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/estoque_mercado
# Obrigatório — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua_chave_secreta_aqui
# Tempo de validade do token de login, em horas
TOKEN_EXPIRA_HORAS=8
# Origens do front-end autorizadas a chamar a API (separadas por vírgula)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Lockout de login: quantas tentativas de senha errada seguidas uma conta
# aguenta antes de ser bloqueada temporariamente, e por quantos minutos o
# bloqueio dura.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Ambiente de execução: "desenvolvimento" (padrão) mantém /docs, /redoc e
# /openapi.json acessíveis. Defina como "producao" para desativar essas rotas
# de documentação, que expõem sem autenticação toda a estrutura da API.
AMBIENTE=desenvolvimento

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui
SMTP_FROM=seu_email@gmail.com
